# logo.dev, https://www.logo.dev/docs/introduction
#
# The publishable key is safe in client code and is the only one the site
# ships. It is prefixed NEXT_PUBLIC_ deliberately: the value ends up in the
# browser bundle either way, and pretending otherwise is worse than saying so.
NEXT_PUBLIC_LOGODEV_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxx

# Server only. Used by scripts/fetch-logos.ts at build time, never imported
# from anything under app/ or components/. If this ever needs NEXT_PUBLIC_
# in front of it, the design is wrong.
LOGODEV_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxx
